# Text files are stored and checked out with LF; dotnet format and the CI expect LF everywhere.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.zip binary
*.mmdb binary

# Written by panorama/tools/gen_k4_ui.py and gen_k4_css.py; edit the generators instead.
panorama/k4system/panorama/layout/custom_game/k4_ui.xml linguist-generated
panorama/k4system/panorama/styles/custom_game/k4_ui.css linguist-generated
