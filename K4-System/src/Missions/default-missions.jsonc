  "matches-played-2": { "Type": "MatchesPlayed", "Difficulty": "Medium", "Target": 2 },
  "m4-kills-12": { "Type": "WeaponKills", "Weapon": "m4a1", "Difficulty": "Medium", "Target": 12 },
  "playtime-60": { "Type": "PlaytimeMinutes", "Difficulty": "Medium", "Target": 60 },
