// K4-System missions.
// Every day each player gets one Easy, one Medium, and one Hard mission from this list, and every week one Weekly mission.
// K4 checks each map and only gives missions that can be done there. A mission that does not fit the map is swapped
// for free while it is untouched; a started one waits and can be finished on another map.
// The key (for example "kills-15") is stored in the database. Do not rename keys that players may have today.
//
// Types:
//   Kills, Headshots, KnifeKills, GrenadeKills (HE or fire), NoscopeKills, ZeusKills, Assists, FlashAssists
//   WeaponKills (needs "Weapon"), PistolKills, SmgKills, ShotgunKills, RifleKills, SniperKills
//   WallbangKills, SmokeKills (through smoke), JumpKills (in the air), BlindKills (while flashed), RevengeKills
//   LongRangeKills ("Distance" in meters, 30 if left out)
//   OpeningKills (first kill of the round), ClutchWins (win a round as the last one alive), SurviveRounds
//   RoundKills (that many kills in one round), LifeKills (that many kills in one life), Damage
//   Mvps, RoundWins, BombPlants, BombDefuses, HostageRescues, PlaytimeMinutes, MatchesPlayed, MatchWins
// Difficulty: Easy, Medium, Hard, or Weekly. Rewards per difficulty are set in k4-system.jsonc (missions.rewards).
// Remove every Weekly mission to turn the weekly mission off.
// Optional "Reward": points for this one mission instead of the difficulty's reward.
// WeaponKills needs "Weapon": part of the CS2 weapon name, such as "ak47", "m4a1" (both M4s), "awp", "deagle".
{
  "kills-15": { "Type": "Kills", "Difficulty": "Easy", "Target": 15 },
  "headshots-5": { "Type": "Headshots", "Difficulty": "Easy", "Target": 5 },
  "assists-5": { "Type": "Assists", "Difficulty": "Easy", "Target": 5 },
  "round-wins-6": { "Type": "RoundWins", "Difficulty": "Easy", "Target": 6 },
  "playtime-20": { "Type": "PlaytimeMinutes", "Difficulty": "Easy", "Target": 20 },
  "ak47-kills-5": { "Type": "WeaponKills", "Weapon": "ak47", "Difficulty": "Easy", "Target": 5 },
  "pistol-kills-5": { "Type": "PistolKills", "Difficulty": "Easy", "Target": 5 },
  "rifle-kills-10": { "Type": "RifleKills", "Difficulty": "Easy", "Target": 10 },
  "damage-1500": { "Type": "Damage", "Difficulty": "Easy", "Target": 1500 },
